# =============================================================================
# Bot Downloader — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust the values.
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# =============================================================================


# ── App ──────────────────────────────────────────────────────────────────────

# Nama aplikasi (tampil di response API)
APP_NAME=Bot Downloader

# Versi aplikasi
APP_VERSION=1.0.0

# Mode debug (true/false) — aktifkan logging lebih detail
DEBUG=false


# ── REST API ─────────────────────────────────────────────────────────────────

# Host binding (0.0.0.0 = akses dari luar container)
API_HOST=0.0.0.0

# Port REST API (dipakai saat run lokal / venv)
# Di Docker port TIDAK dipublish — akses hanya via network internal
# (cloudflared tunnel ke http://bot-downloader:8000)
API_PORT=8000

# Jumlah worker process.
# Rekomendasi: 1 bila memakai webhook Telegram (mencegah set_webhook ganda).
API_WORKERS=1

# Public URL untuk webhook Telegram (WAJIB diisi untuk production)
# Contoh: https://bot.example.com
# Telegram mewajibkan HTTPS untuk webhook. Tanpa path — webhook otomatis
# dipasang di <APP_URL>/webhook
APP_URL=


# ── Telegram Bot ─────────────────────────────────────────────────────────────

# Token bot dari @BotFather di Telegram (WAJIB diisi agar bot jalan)
# Format: 1234567890:ABCdefGHIjklmNOPqrstUVwxyz
TELEGRAM_BOT_TOKEN=

# Batasi user yang boleh menggunakan bot (opsional)
# Format: id_user1,id_user2 (pisahkan dengan koma)
# Kosongkan = semua user boleh menggunakan bot
# Cara dapat ID: kirim pesan ke @userinfobot di Telegram
TELEGRAM_ALLOWED_USERS=


# ── Download ─────────────────────────────────────────────────────────────────

# Direktori penyimpanan file sementara.
# Lokal Windows : ./downloads
# Lokal Linux   : ./downloads atau /tmp/downloads
# Docker        : otomatis dioverride ke /tmp/downloads via docker-compose.yml
DOWNLOAD_DIR=./downloads

# Maksimal ukuran per file yang dikirim (dalam MB)
# Telegram membatasi upload bot ~50MB per file.
# File yang melebihi batas dilewati (bot) / ditolak 413 (API).
MAX_FILE_SIZE_MB=50

# Timeout request download (dalam detik)
REQUEST_TIMEOUT=30


# ── Logs ─────────────────────────────────────────────────────────────────────

# Direktori log interaksi per chat (satu file JSON per chat ID).
# Docker: otomatis dioverride ke /app/logs via docker-compose.yml
LOGS_DIR=logs


# ── yt-dlp (opsional) ────────────────────────────────────────────────────────

# Path ke file cookies (untuk akses konten terbatas/private, mis. Instagram
# yang membatasi akses tanpa login)
# Format: Netscape cookie file (export dari browser)
# YTDLP_COOKIES_FILE=/app/cookies.txt

# Custom User-Agent untuk request (jika default diblokir)
# YTDLP_USER_AGENT=Mozilla/5.0 ...
